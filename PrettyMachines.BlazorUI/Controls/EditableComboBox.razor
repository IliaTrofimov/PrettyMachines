@inject IStringLocalizer<Locale.Controls> LocControls


<div class="editable-combo">
    <div class="input-group input-group-sm">
        <input type="text" class="form-control @(Value.IsSpecial ? "text-info-emphasis fst-italic" : "fw-bold font-monospace")" id="@Id"
               value="@DisplayText"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@Value.IsSpecial"
               autocomplete="off"
               aria-autocomplete="list"
               aria-readonly="@(Value.IsSpecial ? "true" : "false")"
               aria-expanded="@(isOpen ? "true" : "false")"
               @oninput="OnInput"
               @onfocus="Open"
               @onblur="Close"
               @onkeydown="OnKeyDown" />

        <button type="button" class="btn btn-outline-secondary"
                disabled="@Disabled"
                title="@LocControls["Show"]"
                aria-label="@LocControls["Show"]"
                @onmousedown:preventDefault="true"
                @onclick="ToggleList">
            <Icon Name="@(isOpen ? "chevron-up" : "chevron-down")" />
        </button>
    </div>

    @if (isOpen && !Disabled && Options.Count > 0)
    {
        <div class="editable-combo-menu dropdown-menu show" role="listbox"
             @onmousedown:preventDefault="true">
            @for (var i = 0; i < Options.Count; i++)
            {
                var option = Options[i];
                var isActive = i == activeIndex;
                var _i = i;
                var isSelected = Value.IsSpecial && Value.SpecialKey == option.Key;
                <button type="button" class="dropdown-item @(isActive ? "active" : string.Empty)"
                        role="option" aria-selected="@(isSelected ? "true" : "false")"
                        @onclick="() => SelectOption(option, _i)">
                    <span>@option.Label</span>
                    @if (!string.IsNullOrEmpty(option.Description))
                    {
                        <span class="editable-combo-option-desc">@option.Description</span>
                    }
                </button>
            }
        </div>
    }
</div>


@code {
    private bool isOpen;
    private int activeIndex = -1;


    [Parameter]
    public string? Id { get; set; }

    /// <summary>Gets or sets the current value: free text or a special dropdown option.</summary>
    [Parameter]
    public ComboValue Value { get; set; }

    [Parameter]
    public EventCallback<ComboValue> ValueChanged { get; set; }

    /// <summary>Gets or sets the special options shown only in the dropdown.</summary>
    [Parameter]
    public IReadOnlyList<ComboOption> Options { get; set; } = [];

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }


    private string DisplayText
    {
        get
        {
            if (!Value.IsSpecial)
                return Value.Text ?? string.Empty;

            var option = Options.FirstOrDefault(o => o.Key == Value.SpecialKey);
            return option?.Label ?? Value.SpecialKey ?? string.Empty;
        }
    }


    private void Open() => isOpen = true;

    private void Close() => isOpen = false;

    private void ToggleList()
    {
        isOpen = !isOpen;
        activeIndex = -1;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = ComboValue.FromText(e.Value?.ToString());
        isOpen = true;
        activeIndex = -1;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SelectOption(ComboOption option, int index)
    {
        Value = ComboValue.FromSpecial(option.Key);
        isOpen = false;
        activeIndex = index;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // A special value is displayed read-only, so the first edit replaces it as a
        // whole instead of editing individual characters of its label.
        if (Value.IsSpecial)
        {
            if (e.Key is "Backspace" or "Delete")
            {
                Value = ComboValue.FromText(string.Empty);
                isOpen = false;
                activeIndex = -1;
                await ValueChanged.InvokeAsync(Value);
                return;
            }

            if (e.Key.Length == 1 && !e.CtrlKey && !e.MetaKey && !e.AltKey)
            {
                Value = ComboValue.FromText(e.Key);
                isOpen = true;
                activeIndex = -1;
                await ValueChanged.InvokeAsync(Value);
                return;
            }
        }

        switch (e.Key)
        {
            case "ArrowDown" when Options.Count > 0:
                isOpen = true;
                activeIndex = (activeIndex + 1) % Options.Count;
                break;
            case "ArrowUp" when Options.Count > 0:
                isOpen = true;
                activeIndex = (activeIndex - 1 + Options.Count) % Options.Count;
                break;
            case "Enter":
                if (isOpen && activeIndex >= 0 && activeIndex < Options.Count)
                    await SelectOption(Options[activeIndex], activeIndex);
                else
                    isOpen = false;
                break;
            case "Escape":
                isOpen = false;
                activeIndex = -1;
                break;
        }
    }
}
