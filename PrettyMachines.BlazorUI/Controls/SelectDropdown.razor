@typeparam TValue


<div class="dropdown">
    <button type="button"
            class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 d-flex align-items-center justify-content-between font-monospace"
            data-bs-toggle="dropdown"
            disabled="@Disabled">
        @SelectedText
    </button>

    <ul class="dropdown-menu select-dropdown-menu">
        @foreach (var option in Options)
        {
            var captured = option;
            <li>
                <button type="button"
                        class="dropdown-item font-monospace text-nowrap @(IsSelected(captured) ? "active" : null)"
                        @onclick="() => ValueChanged.InvokeAsync(captured.Value)">
                    @captured.FullText
                </button>
            </li>
        }
    </ul>
</div>


@code {
    /// <summary>Gets or sets the currently selected value.</summary>
    [Parameter]
    public TValue Value { get; set; } = default!;

    /// <summary>Gets or sets the callback invoked when the user picks another value.</summary>
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Gets or sets the selectable options.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SelectOption<TValue>> Options { get; set; } = Array.Empty<SelectOption<TValue>>();

    /// <summary>Disable or enable this control.</summary>
    [Parameter]
    public bool Disabled { get; set; }


    private string? SelectedText => Options.FirstOrDefault(IsSelected)?.ShortText;

    private bool IsSelected(SelectOption<TValue> option) => EqualityComparer<TValue>.Default.Equals(option.Value, Value);
}
