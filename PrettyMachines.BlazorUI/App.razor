@using PrettyMachines.BlazorUI.Components
@using PrettyMachines.BlazorUI.Layout
@using PrettyMachines.BlazorUI.Pages

@inject NavigationManager Navigation

<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
                <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)">
                    <PrettyMachines.BlazorUI.Pages.NotFound/>
                </LayoutView>
            </NotFound>
        </Router>
    </ChildContent>
    <ErrorContent Context="caughtException">
        <ErrorDisplay Error="caughtException" IsProduction="false"/>
    </ErrorContent>
</ErrorBoundary>

@code{
    protected override void OnInitialized()
    {
        var queryString = new Uri(Navigation.Uri).Query;
        var query = System.Web.HttpUtility.ParseQueryString(queryString);            
        if (query.Get("lang") is not {} language)
        {
            
        }

        base.OnInitialized();
    }
}
