@inject NavigationManager Navigation
@inject AlgorithmDraftStore DraftStore
@inject DraftPersistenceService DraftPersistence
@inject IStringLocalizer<Locale.Controls> LocControls
@inject AlgorithmLocalizer LocNames    
@implements IDisposable

<div class="nav-root">
    <button type="button" class="btn btn-primary nav-toggle w-100 d-lg-none"
            aria-controls="nav-sidebar" aria-expanded="@(menuOpen ? "true" : "false")"
            aria-label="Toggle navigation" @onclick="ToggleMenu">
        <Icon Name="menu" /> @LocControls["Menu"]
    </button>

    <nav id="nav-sidebar"
         class="navigation offcanvas-lg offcanvas-start @(menuOpen ? "show" : "")"
         tabindex="-1" aria-label="Main navigation">
        <div class="nav-body d-flex flex-column flex-grow-1 p-3">
            <h1 class="nav-title fs-4 mb-0">
                <a href="" class="link-body-emphasis text-decoration-none">Pretty Machines</a>
            </h1>
            <hr/>

            <ul class="list-unstyled ps-0 mb-0">
                @if (families.Count == 0)
                {
                    <li><i>@LocControls["NoContent"]</i></li>
                }

                @foreach (var family in families)
                {
                    <li class="mb-1">
                        <button type="button"
                                class="btn btn-toggle d-inline-flex align-items-center rounded border-0 @CollapsedClass(family.Id)"
                                aria-expanded="@(IsExpanded(family.Id) ? "true" : "false")"
                                @onclick="() => Toggle(family.Id)">
                            <Icon Name="chevron-right" Class="btn-toggle-icon me-1" />
                            @LocNames.GetAlgorithmFamilyName(family.Id)
                        </button>
                        <div class="@ExpandedClass(family.Id)">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                                <li>
                                    <a href="editor/@family.Id" class="link-body-emphasis d-inline-flex align-items-center text-decoration-none rounded">
                                        <Icon Name="plus" Class="me-1" />@LocControls["CreateNew"]
                                    </a>
                                </li>
                                @foreach (var algorithm in family.Algorithms)
                                {
                                    <li>
                                        <a href="algorithm/@family.Id/@algorithm.Id"
                                           class="link-body-emphasis d-inline-flex text-decoration-none rounded">
                                            @LocNames.GetAlgorithmName(algorithm.Name)
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }

                @{
                    var drafts = DraftStore.Drafts;
                }
                @if (drafts.Count > 0)
                {
                    <li class="mb-1">
                        <button type="button"
                                class="btn btn-toggle d-inline-flex align-items-center rounded border-0 @CollapsedClass(CustomSectionId)"
                                aria-expanded="@(IsExpanded(CustomSectionId) ? "true" : "false")"
                                @onclick="() => Toggle(CustomSectionId)">
                            <Icon Name="chevron-right" Class="btn-toggle-icon me-1" />
                            @LocControls["Custom"]
                        </button>
                        <div class="@ExpandedClass(CustomSectionId)">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                                @foreach (var draft in drafts)
                                {
                                    <li class="d-flex align-items-center">
                                        <a href="draft/@draft.Id"
                                           class="link-body-emphasis d-inline-flex flex-grow-1 text-decoration-none rounded">
                                            @draft.Name
                                        </a>
                                        <button type="button" class="btn btn-link text-danger p-0 ms-1 lh-1"
                                                title="@LocControls["Delete"]" aria-label="@LocControls["Delete"]"
                                                @onclick="() => DeleteDraft(draft)">
                                            <Icon Name="clear" />
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            </ul>

            <hr class="mt-auto"/>
            <div class="nav-footer small text-body-secondary">
                <div>
                    <a href="https://github.com/IliaTrofimov/PrettyMachines" target="_blank" rel="noopener" class="d-inline-flex align-items-center">
                        <Icon Name="github" Class="me-1" />@LocControls["GitHub"]
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <Icon Name="globe" />@LocControls["Language"] <LanguageSelector/>
                </div>
            </div>
        </div>
    </nav>

    @if (menuOpen)
    {
        <div class="offcanvas-backdrop fade show d-lg-none" @onclick="CloseMenu"></div>
    }
</div>

@code {
    private const string CustomSectionId = "custom";

    private readonly HashSet<string> expanded = [];
    private IReadOnlyList<AlgorithmFamily> families = [];
    private bool menuOpen;

    protected override void OnInitialized()
    {
        families = AlgorithmCatalog.Discover();
        if (families.Count > 0)
            expanded.Add(families[0].Id);

        DraftStore.Changed += OnDraftsChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnDraftsChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!menuOpen)
            return;

        menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private async Task DeleteDraft(AlgorithmDraft draft)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0];
        await DraftPersistence.DeleteAsync(draft);

        if (string.Equals(path, $"draft/{draft.Id}", StringComparison.Ordinal))
            Navigation.NavigateTo("");
    }

    private void Toggle(string id)
    {
        if (!expanded.Remove(id))
            expanded.Add(id);
    }

    private bool IsExpanded(string id) => expanded.Contains(id);

    private string CollapsedClass(string id) => IsExpanded(id) ? "" : "collapsed";

    private string ExpandedClass(string id) => IsExpanded(id) ? "collapse show" : "collapse";

    public void Dispose()
    {
        DraftStore.Changed -= OnDraftsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
