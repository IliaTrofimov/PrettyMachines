@inject NavigationManager Navigation
@inject AlgorithmDraftStore DraftStore
@inject IStringLocalizer<Locale.Controls> LocControls
@inject AlgorithmLocalizer LocNames    
@implements IDisposable

<div class="nav-root">
    <button class="nav-toggle" @onclick="ToggleMenu" aria-label="Toggle navigation">
        ☰
    </button>
    <div class="navigation @(menuOpen ? "open" : "")">
        <h1 class="nav-title" @onclick="OpenHome">
            Pretty Machines
        </h1>
        <div>
            @if (families.Count == 0)
            {
                <i>@LocControls["NoContent"]</i>
            }

            @foreach (var family in families)
            {
                <div class="nav-item">
                    <h4 @onclick="() => Toggle(family.Id)"
                        class="@(expanded.Contains(family.Id) ? "expanded" : "collapsed")">
                        @LocNames.GetAlgorithmFamilyName(family.Id)
                    </h4>
                    <ol class="nav-subitem @(expanded.Contains(family.Id) ? "show" : "hide")">
                        <li @onclick="() => OpenEditor(family.Id)">
                            <i>+ @LocControls["CreateNew"]</i>
                        </li>
                        @foreach (var algorithm in family.Algorithms)
                        {
                            <li @onclick="() => OpenAlgorithm(family.Id, algorithm.Id)">
                                @LocNames.GetAlgorithmName(algorithm.Name)
                            </li>
                        }
                    </ol>
                </div>
            }

            @if (DraftStore.Drafts.Count > 0)
            {
                <div class="nav-item">
                    <h4 @onclick="() => Toggle(CustomSectionId)"
                        class="@(expanded.Contains(CustomSectionId) ? "expanded" : "collapsed")">
                        @LocControls["Custom"]
                    </h4>
                    <ol class="nav-subitem @(expanded.Contains(CustomSectionId) ? "show" : "hide")">
                        @foreach (var draft in DraftStore.Drafts)
                        {
                            <li @onclick="() => OpenDraft(draft.Id)">
                                @draft.Name
                            </li>
                        }
                    </ol>
                </div>
            }
        </div>
    </div>

    <div class="fixed-bottom">
        <div>
            See <a href="https://github.com/IliaTrofimov/PrettyMachines" target="_blank" rel="noopener">GitHub</a> repository
        </div>
        <div>
            Language <LanguageSelector/>
        </div>
    </div>
</div>

@code {
    private const string CustomSectionId = "custom";

    private readonly HashSet<string> expanded = [];
    private IReadOnlyList<AlgorithmFamily> families = [];
    private bool menuOpen;

    protected override void OnInitialized()
    {
        families = AlgorithmCatalog.Discover();
        if (families.Count > 0)
            expanded.Add(families[0].Id);

        DraftStore.Changed += OnDraftsChanged;
    }

    private void OnDraftsChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void Toggle(string id)
    {
        if (!expanded.Remove(id))
            expanded.Add(id);
    }

    private void OpenHome() => Navigate("");

    private void OpenEditor(string familyId) => Navigate($"editor/{familyId}");

    private void OpenAlgorithm(string familyId, string algorithmId) =>
        Navigate($"algorithm/{familyId}/{algorithmId}");

    private void OpenDraft(string draftId) => Navigate($"draft/{draftId}");

    private void Navigate(string url)
    {
        menuOpen = false;
        Navigation.NavigateTo(url);
    }

    public void Dispose() => DraftStore.Changed -= OnDraftsChanged;
}
