@inject IStringLocalizer<Locale.Controls> LocControls;


<h5 class="mt-1 mb-1">
    @LocControls["States"]
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="AddState">
        <Icon Name="plus" Class="me-1" />@LocControls["AddState"]
    </button>
</h5>

<div class="turing-grid states-grid" role="table">
    <div class="turing-row turing-header" role="row">
        <div class="turing-index" role="columnheader">#</div>
        <div class="turing-cell" role="columnheader">@LocControls["Name"]</div>
        <div class="turing-actions" role="columnheader"></div>
    </div>

    @for (var i = 0; i < Draft.States.Count; i++)
    {
        var captured = Draft.States[i];
        <div class="turing-row" role="row">
            <div class="turing-index" role="cell">q@($"{i:d2}")</div>
            <div class="turing-cell" role="cell" data-label="@LocControls["Name"]">
                <div class="turing-composite form-control form-control-sm d-flex align-items-center gap-2">
                    <input type="text" class="form-control form-control-sm font-monospace border-0 p-0 shadow-none bg-transparent flex-grow-1"
                           @bind="captured.Name"
                    />
                         
                    <ToggleButton Id=@($"state-initial-{i}") Value="@captured.IsInitial" ValueChanged="_ => SetInitial(captured)"
                        Text="@LocControls["StartStateShort"]" Title="@LocControls["StartState"]"
                        ClassLabel="btn-sm btn-outline-secondary"
                    />

                    <ToggleButton Id=@($"state-terminal-{i}") @bind-Value="captured.IsTerminal" Disabled="@captured.IsInitial" 
                        TextChecked="@LocControls["TerminalStateShort"]" TextUnchecked="@LocControls["NonTerminalStateShort"]"
                        TitleChecked="@LocControls["TerminalState"]" TitleUnchecked="@LocControls["NonTerminalState"]"
                        ClassLabel="btn-sm btn-outline-secondary"
                    />
                </div>
            </div>
            <div class="turing-actions" role="cell">
                <button type="button" class="btn btn-sm btn-outline-danger turing-remove"
                        @onclick="() => Update(() => RemoveState(captured))">
                    <Icon Name="minus" />
                </button>
            </div>
        </div>
    }
</div>

<h5 class="mt-3 mb-1">
    @LocControls["Transitions"]
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="AddTransition">
        <Icon Name="plus" Class="me-1" />@LocControls["AddTransition"]
    </button>
</h5>

<div class="turing-grid transitions-grid" role="table">
    <div class="turing-row turing-header" role="row">
        <div class="turing-cell" role="columnheader">@LocControls["State"]</div>
        <div class="turing-cell" role="columnheader">@LocControls["Value"]</div>
        <div class="turing-cell" role="columnheader">@LocControls["Next"]</div>
        <div class="turing-cell" role="columnheader">@LocControls["Print"]</div>
        <div class="turing-cell" role="columnheader">@LocControls["Move"]</div>
        <div class="turing-actions" role="columnheader"></div>
    </div>

    @for (var i = 0; i < Draft.Transitions.Count; i++)
    {
        var captured = Draft.Transitions[i];
        <div class="turing-row" role="row">
            <div class="turing-cell" role="cell" data-label="@LocControls["State"]">
                <SelectDropdown TValue="int"
                                Value="captured.StateIndex"
                                ValueChanged="index => Update(() => captured.StateIndex = index)"
                                Options="StateOptions" />
            </div>
            <div class="turing-cell" role="cell" data-label="@LocControls["Value"]">
                <EditableComboBox Id="@($"transition-value-{i}")"
                                  Value="SymbolToCombo(captured)"
                                  Options="symbolOptions"
                                  Placeholder="@LocControls["Exact"]"
                                  ValueChanged="v => Update(() => ApplySymbol(captured, v))" />
            </div>
            <div class="turing-cell" role="cell" data-label="@LocControls["Next"]">
                <SelectDropdown TValue="int"
                                Value="captured.NextStateIndex"
                                ValueChanged="index => Update(() => captured.NextStateIndex = index)"
                                Options="NextStateOptions" />
            </div>
            <div class="turing-cell" role="cell" data-label="@LocControls["Print"]">
                <EditableComboBox Id="@($"transition-print-{i}")"
                                  Value="PrintToCombo(captured)"
                                  Options="printOptions"
                                  Placeholder="@LocControls["Print"]"
                                  ValueChanged="v => Update(() => ApplyPrint(captured, v))" />
            </div>
            <div class="turing-cell" role="cell" data-label="@LocControls["Move"]">
                <SelectDropdown TValue="TapeMovement"
                                Value="captured.Movement"
                                ValueChanged="movement => Update(() => captured.Movement = movement)"
                                Options="MovementOptions" />
            </div>
            <div class="turing-actions" role="cell">
                <button type="button" class="btn btn-sm btn-outline-danger turing-remove"
                        @onclick="() => Update(() => Draft.Transitions.Remove(captured))">
                    <Icon Name="minus" />
                </button>
            </div>
        </div>
    }
</div>


@code {
    private string newSymbol = string.Empty;

    [Parameter, EditorRequired]
    public TuringMachineDraft Draft { get; set; } = null!;

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }


    private async Task Update(Action change)
    {
        change();
        await OnChanged.InvokeAsync();
    }

    private void AddSymbol()
    {
        if (string.IsNullOrEmpty(newSymbol))
            return;

        if (!Draft.Alphabet.Contains(newSymbol))
            Draft.Alphabet.Add(newSymbol);
        newSymbol = string.Empty;
    }

    private void ReplaceSymbol(string oldSymbol, string newValue)
    {
        var index = Draft.Alphabet.IndexOf(oldSymbol);
        if (index < 0 || string.IsNullOrEmpty(newValue))
            return;

        Draft.Alphabet[index] = newValue;
    }

    private void SetInitial(DraftState state)
    {
        foreach (var other in Draft.States)
            other.IsInitial = false;
        state.IsTerminal = false;
        state.IsInitial = true;
        StateHasChanged();
    }

    private void RemoveState(DraftState state)
    {
        var index = Draft.States.IndexOf(state);
        if (index < 0)
            return;

        Draft.States.RemoveAt(index);

        foreach (var transition in Draft.Transitions)
        {
            if (transition.StateIndex == index)
                transition.StateIndex = 0;
            else if (transition.StateIndex > index)
                transition.StateIndex--;

            if (transition.NextStateIndex == index)
                transition.NextStateIndex = -1;
            else if (transition.NextStateIndex > index)
                transition.NextStateIndex--;
        }

        Draft.Transitions.RemoveAll(t => t.StateIndex < 0);
    }

    private void AddState() => Draft.States.Add(new DraftState { Name = $"q{Draft.States.Count:D2}" });

    private void AddTransition() => Draft.Transitions.Add(new DraftTransition
    {
        StateIndex = Math.Max(0, Draft.States.FindIndex(s => !s.IsTerminal)),
        NextStateIndex = -1,
        Movement = TapeMovement.None,
    });

    private const string PrintNoneKey = "none";
    private const string PrintEraseKey = "erase";

    private IReadOnlyList<ComboOption> symbolOptions =>
    [
        new() { Key = nameof(SymbolMatch.Any), Label = LocControls["Any"].Value },
        new() { Key = nameof(SymbolMatch.Empty), Label = LocControls["Empty"].Value },
        new() { Key = nameof(SymbolMatch.NotEmpty), Label = LocControls["NotEmpty"].Value },
    ];

    private IReadOnlyList<ComboOption> printOptions =>
    [
        new() { Key = PrintEraseKey, Label = LocControls["Erase"].Value },
        new() { Key = PrintNoneKey, Label = LocControls["None"].Value },
    ];


    private static ComboValue SymbolToCombo(DraftTransition transition)
    {
        return transition.SymbolMatch == SymbolMatch.Exact
            ? ComboValue.FromText(transition.SymbolValue)
            : ComboValue.FromSpecial(transition.SymbolMatch.ToString());
    }

    private static void ApplySymbol(DraftTransition transition, ComboValue value)
    {
        if (value.IsSpecial && Enum.TryParse<SymbolMatch>(value.SpecialKey, out var match))
        {
            transition.SymbolMatch = match;
            transition.SymbolValue = string.Empty;
        }
        else
        {
            transition.SymbolMatch = SymbolMatch.Exact;
            transition.SymbolValue = value.Text ?? string.Empty;
        }
    }

    private ComboValue PrintToCombo(DraftTransition transition)
    {
        if (!transition.Prints)
            return ComboValue.FromSpecial(PrintNoneKey);

        if (!string.IsNullOrEmpty(Draft.BlankSymbol) &&
            string.Equals(transition.Print, Draft.BlankSymbol, StringComparison.Ordinal))
            return ComboValue.FromSpecial(PrintEraseKey);

        return ComboValue.FromText(transition.Print);
    }

    private void ApplyPrint(DraftTransition transition, ComboValue value)
    {
        if (value.IsSpecial && value.SpecialKey == PrintNoneKey)
        {
            transition.Prints = false;
            transition.Print = string.Empty;
        }
        else if (value.IsSpecial && value.SpecialKey == PrintEraseKey)
        {
            transition.Prints = true;
            transition.Print = Draft.BlankSymbol;
        }
        else
        {
            transition.Prints = true;
            transition.Print = value.Text ?? string.Empty;
        }
    }

    private IReadOnlyList<SelectOption<int>> StateOptions => Enumerable.Range(0, Draft.States.Count)
        .Select(StateOption)
        .ToArray();

    private IReadOnlyList<SelectOption<int>> NextStateOptions => Enumerable.Range(-1, Draft.States.Count + 1)
        .Select(StateOption)
        .ToArray();

    private IReadOnlyList<SelectOption<TapeMovement>> MovementOptions =>
    [
        MovementOption(TapeMovement.None, LocControls["None"].Value, ""),
        MovementOption(TapeMovement.Left, "<<<", LocControls["Left"].Value),
        MovementOption(TapeMovement.Right, ">>>", LocControls["Right"].Value),
    ];

    private SelectOption<int> StateOption(int index) => new()
    {
        Value = index,
        ShortText = ShortStateName(index),
        FullText = FullStateName(index),
    };

    private static SelectOption<TapeMovement> MovementOption(TapeMovement movement, string arrow, string name) => new()
    {
        Value = movement,
        ShortText = arrow,
        FullText = $"{arrow} {name}",
    };

    private string ShortStateName(int index)
    {
        if (index == -1)
            return LocControls["Halt"].Value;
        return index >= 0 && index < Draft.States.Count ? $"q{index:D2}" : "?";
    }

    private string FullStateName(int index) =>
        index == -1 ? LocControls["Halt"].Value : Draft.GetStateName(index);
}
