@using System.Data
@inject IStringLocalizer<Locale.Controls> LocControls


<h5 class="mt-1 mb-1">
    @LocControls["Rules"]
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="AddRule">
        <Icon Name="plus" Class="me-1" />@LocControls["AddRule"]
    </button>
</h5>


<div class="rules-grid @(CommentsExpanded ? "is-comments-expanded" : string.Empty)" role="table">
    <div class="rule-row rules-header" role="row">
        <div class="rule-index" role="columnheader">
            #
        </div>
        <div class="rule-input" role="columnheader">
            @LocControls["Pattern"]
        </div>
        <div class="rule-arrow" role="columnheader"></div>
        <div class="rule-input" role="columnheader">
            @LocControls["Replacement"]
        </div>
        <div class="rule-comment" role="columnheader">
            <button type="button" class="btn btn-sm btn-link p-0 rule-comment-toggle d-flex align-items-center gap-1"
                title="@LocControls["Comment"]" aria-label="@LocControls["Comment"]" aria-expanded="@CommentsExpanded"
                @onclick="ToggleComments">
                <Icon Name="@(CommentsExpanded ? "chevron-down" : "chevron-right")" />
                <span class="rule-comment-label">@LocControls["Comment"]</span>
            </button>
        </div>
        <div class="rule-actions" role="columnheader"></div>
    </div>

    @for (var i = 0; i < Draft.Rules.Count; i++)
    {
        var rule = Draft.Rules[i];
        var index = i;

        <div class="rule-row" role="row">
            <div class="rule-index" role="cell">
                @index
            </div>
            <div class="rule-input" role="cell">
                <input type="text" class="form-control form-control-sm font-monospace" 
                    value="@rule.Pattern"
                    @onchange="e => Update(() => rule.Pattern = e.Value?.ToString() ?? string.Empty)" 
                />
            </div>
            <div class="rule-arrow" role="cell">
                @if (rule.IsTerminal)
                {
                    <text>→⬝</text>
                }
                else
                {
                    <text>→</text>
                }
            </div>
            <div class="rule-input" role="cell">
                <div class="rule-replacement form-control form-control-sm d-flex align-items-center gap-2 ">
                    <input type="text" class="form-control form-control-sm font-monospace border-0 p-0 shadow-none bg-transparent flex-grow-1"
                        value="@rule.Replacement"
                        @onchange="e => Update(() => rule.Replacement = e.Value?.ToString() ?? string.Empty)" />

                    <input type="checkbox" class="btn-check" id="@($"rule-terminal-{index}")" checked="@rule.IsTerminal"
                        @onchange="e => Update(() => rule.IsTerminal = e.Value is true)" />

                    <label class="btn btn-sm btn-outline-secondary rule-terminal-toggle" for="@($"rule-terminal-{index}")"
                        title="@(rule.IsTerminal ? LocControls["TerminalState"] : LocControls["NonTerminalState"])">
                        @(rule.IsTerminal ? LocControls["TerminalStateShort"] : LocControls["NonTerminalStateShort"])
                    </label>
                </div>
            </div>

            <div class="rule-comment" role="cell">
                @if (CommentsExpanded)
                {
                    <input type="text" class="form-control form-control-sm" @bind-value="rule.Comment"/>
                }
                else
                {
                    <span title="@rule.Comment" @onclick="() => CommentsExpanded = true">
                        @rule.Comment
                    </span>
                }
            </div>

            <div class="rule-actions" role="cell">
                <button type="button" class="btn btn-sm btn-outline-danger rule-remove"
                    @onclick="() => Update(() => Draft.Rules.RemoveAt(index))">
                    <Icon Name="minus" />
                </button>
            </div>
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired]
    public MarkovAlgorithmDraft Draft { get; set; } = null!;

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }


    private string AlphabetText => new(Draft.Alphabet.ToArray());

    private string MarkersText => new(Draft.Markers.ToArray());

    private List<string> DuplicatePatterns => Draft.Rules
        .GroupBy(rule => rule.Pattern, StringComparer.Ordinal)
        .Where(group => group.Count() > 1)
        .Select(group => group.Key)
        .ToList();

    private bool CommentsExpanded { get; set; }


    private async Task Update(Action change)
    {
        change();
        await OnChanged.InvokeAsync();
    }

    private void SetChars(List<char> target, string? text)
    {
        target.Clear();
        if (string.IsNullOrEmpty(text))
            return;

        target.AddRange(text.Distinct());
    }

    private void AddRule() => Draft.Rules.Add(new DraftRule());

    private void ToggleComments() => CommentsExpanded = !CommentsExpanded;
}
