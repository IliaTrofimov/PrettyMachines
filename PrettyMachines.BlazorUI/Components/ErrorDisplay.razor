@inject IStringLocalizer<Locale.Controls> LocControls;

<div class="container">
    @if (isProduction)
    {
        <h3>@LocControls["ErrorOccurred"]</h3>
        <hr/>
        <div>
            @Error.Message
        </div>
    }
    else
    {
        <h3>
            Error happened:
            @if (Error.GetType().Name.Contains("Exception"))
            {
                <text>unhandled</text>
                <u>@Error.GetType().Name</u>
            }
            else
            {
                <text>unhandled exception</text>
                <u>@Error.GetType().Name</u>
            }
        </h3>
        <div>
            @Error.Message
        </div>
        <hr/>
        <pre class="mono stack-trace">
            @stackTrace
        </pre>
    }
    <hr/>
    <div>
        <a href=".">@LocControls["TryReload"]</a>
    </div>
</div>


@code {
    private const bool isProduction 
    #if RELEASE
        = true;
    #else
        = false;
    #endif


    private string stackTrace = "";
    
    [Parameter]
    public required Exception Error { get; set; }


    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Error.StackTrace) && !isProduction)
        {
            stackTrace = Error.StackTrace.Replace(" in ", "\n\tin");      
        }
    }
}