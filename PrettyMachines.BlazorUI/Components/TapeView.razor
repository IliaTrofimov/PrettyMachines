<div class="tape-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="tape-label">@Label</span>
    }
    <div class="font-monospace d-flex overflow-auto tape-line">
        @foreach (var (cell, index) in Cells)
        {
            <span class="tape-cell @(index == Tape.HeadIndex ? "bg-warning rounded" : "")">
                @Symbol(cell)
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyTape Tape { get; set; } = null!;

    [Parameter]
    public string? Label { get; set; }

    private IEnumerable<(string?, int)> Cells => Tape.EnumerateCells(trimEmptyCells: false)
                                                     .Select((value, index) => (value, index));

    private static string Symbol(string? cell) => string.IsNullOrEmpty(cell) ? "\u00A0" : cell;
}
