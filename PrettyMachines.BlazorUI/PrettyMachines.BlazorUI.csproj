<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <RootNamespace>PrettyMachines.BlazorUI</RootNamespace>
        <RunHotReload>true</RunHotReload>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PrettyMachines.Algorithms\PrettyMachines.Algorithms.csproj" />
      <ProjectReference Include="..\PrettyMachines.Implementations\PrettyMachines.Implementations.csproj" />
    </ItemGroup>


    <PropertyGroup>
      <BaseHref Condition="'$(BaseHref)' == ''">/</BaseHref>
      <BaseHref Condition="'$(BaseHref)' == 'Debug'">/</BaseHref>
      <BaseHref Condition="'$(Configuration)' == 'Release'">/PrettyMachines/</BaseHref>
  </PropertyGroup>
</Project>
