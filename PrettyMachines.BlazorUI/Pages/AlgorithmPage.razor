@page "/algorithm/{FamilyId}/{AlgorithmId}"
@page "/draft/{DraftId}"
@page "/editor/{FamilyId}"


@inject AlgorithmDraftStore DraftStore
@inject NavigationManager Navigation
@inject AlgorithmLocalizer LocNames
@inject IStringLocalizer<Locale.Controls> LocControls
@implements IDisposable


<div class="page-container algorithm-page">
    @if (notFound)
    {
        <div class="card panel-card">
            <h4 class="card-header bg-warning-subtle border-bottom border-2 border-dark fw-semibold">@LocControls["NotFound"]</h4>
            <div class="card-body panel-body">
                <p>@LocControls["AlgorithmNotFound"]</p>
                <a href=".">@LocControls["BackToCatalog"]</a>
            </div>
        </div>
    }
    else
    {
        <div class="card panel-card">
            <h4 class="card-header bg-warning-subtle border-bottom border-2 border-dark fw-semibold">
                @DisplayName
                @if (isDraft)
                {
                    <h6>@LocControls["Draft"]</h6>
                }
                else if (descriptor is not null)
                {
                    <h6>@LocNames.GetAlgorithmFamilyName(descriptor.FamilyId)</h6>
                }
            </h4>

            <div class="card-body panel-body">
                <div class="input-group">
                    <input type="text" id="algorithm-input" class="font-monospace form-control"
                            placeholder="@LocControls["InputPlaceholder"]" @bind="input" />
                    <button type="button" class='btn btn-outline-secondary' title="@LocControls["ResetAlgorithmTooltip"]"
                            @onclick="ClearInput">
                        <Icon Name="clear" Class="me-1" />
                    </button>
                </div>
               
                <div class="d-flex flex-wrap align-items-center gap-5 mb-3 mt-3">
                    <div class="input-group input-group-sm w-auto">
                        <button type="button" class="btn btn-outline-success" disabled="@(!CanExecute)" title="@LocControls["RunTooltip"]" 
                                @onclick="RunAlgorithm">
                            <Icon Name="fast-forward" Class="me-1" />@LocControls["Run"]
                        </button>
                         <button type="button" class="btn btn-outline-success" disabled="@(!CanExecute)" title="@LocControls["AutoStepTooltip"]"
                                @onclick="AutoStepAlgorithm">
                            <Icon Name="run" Class="me-1" />@LocControls["AutoStep"]
                        </button>
                        <button type="button" class="btn btn-outline-success" disabled="@(!CanExecute)" title="@LocControls["StepTooltip"]"
                                @onclick="StepAlgorithm">
                            <Icon Name="step-forward" Class="me-1" />@LocControls["Step"]
                        </button>
                        @{
                            var stopEnabled = session.IsStarted;
                        }
                        <button type="button" class='btn @(!stopEnabled ? "btn-outline-secondary" : "btn-outline-danger")' title="@LocControls["ResetOutputTooltip"]"
                                disabled="@(!stopEnabled)" 
                                @onclick="ClearOutput">
                            <Icon Name="stop" Class="me-1" />@LocControls["Reset"]
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label for="max-steps">@LocControls["MaxSteps"]</label>
                        <input id="max-steps" type="number" min="1" max="99999" class="form-control form-control-sm max-steps-input" 
                                @bind="maxStepsInput" />
                        @if (!maxStepsInput.HasValue)
                        {
                            <label class="form-text">@LocControls["Unlimited"]</label>
                        }
                    </div>
                </div>

                <div class="mt-2">
                    <OutputView Session="@session"/>
                </div>
            </div>
        </div>

        <div class="card panel-card">
            <h4 class="card-header bg-warning-subtle border-bottom border-2 border-dark fw-semibold">
                @LocControls["Definition"]
                @if (descriptor != null)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" >
                        <Icon Name="reset"/>@LocControls["ResetDefinition"]
                    </button>
                }
            </h4>
            <div class="card-body panel-body">
                @if (structureError is not null)
                {
                    <div class="invalid-feedback d-block">@structureError</div>
                }
                else if (session.Error is not null)
                {
                    <div class="invalid-feedback d-block">@session.Error</div>
                }

                @if (draft?.Turing is { } turingDraft)
                {
                    <TuringStructureView Draft="turingDraft" OnChanged="OnStructureChanged" />
                }
                else if (draft?.Markov is { } markovDraft)
                {
                    <MarkovStructureView Draft="markovDraft" OnChanged="OnStructureChanged" />
                }
                else if (structureError is null)
                {
                    <i>@LocControls["NoStructuredDefinition"]</i>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int AutoStepDelayMs = 800;
    private const int RunYieldIntervalMs = 50;

    private readonly AlgorithmRunSession session = new();

    private AlgorithmDescriptor? descriptor;
    private AlgorithmDraft? draft;
    private IAlgorithm? algorithm;
    private bool isDraft;
    private bool notFound;
    private string? structureError;
    private string input = "";
    private int? maxStepsInput = null;
    private string? loadedKey;
    private CancellationTokenSource? executionCts;
    private bool autoStepping;
    private bool disposed;


    [Parameter] public string? FamilyId { get; set; }

    [Parameter] public string? AlgorithmId { get; set; }

    [Parameter] public string? DraftId { get; set; }


    private string DisplayName => draft?.Name ?? LocNames.GetAlgorithmName(descriptor?.Name ?? algorithm?.Name);

    private bool CanExecute => algorithm is not null;


    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0];
        if (string.Equals(path, loadedKey, StringComparison.Ordinal))
            return;

        loadedKey = path;
        Load(path);
    }

    private void Load(string path)
    {
        StopExecution();
        session.Reset();
        descriptor = null;
        draft = null;
        algorithm = null;
        isDraft = false;
        notFound = false;
        structureError = null;
        input = "";

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 && segments[0] == "draft")
        {
            LoadDraft(Uri.UnescapeDataString(segments[1]));
            return;
        }

        if (segments.Length >= 2 && segments[0] == "editor")
        {
            CreateNewDraft(Uri.UnescapeDataString(segments[1]));
            return;
        }

        if (segments.Length >= 3 && segments[0] == "algorithm")
        {
            LoadBuiltIn(Uri.UnescapeDataString(segments[1]), Uri.UnescapeDataString(segments[2]));
            return;
        }

        notFound = true;
    }

    private void LoadDraft(string id)
    {
        if (DraftStore.Get(id) is not { } loaded)
        {
            notFound = true;
            return;
        }

        draft = loaded;
        isDraft = true;
        RebuildDraft();
    }

    private void LoadBuiltIn(string familyId, string algorithmId)
    {
        descriptor = AlgorithmCatalog.Find(familyId, algorithmId);
        if (descriptor is null)
        {
            notFound = true;
            return;
        }

        try
        {
            algorithm = descriptor.Create();
            draft = CreateDisplayDraft(descriptor, algorithm);
            if (!string.IsNullOrEmpty(descriptor.ExampleInput))
                input = descriptor.ExampleInput;
        }
        catch (Exception exception)
        {
            structureError = exception.Message;
        }
    }

    private void CreateNewDraft(string familyId)
    {
        try
        {
            var created = DraftAlgorithmFactory.CreateBlank(familyId);
            DraftStore.Add(created);
            Navigation.NavigateTo($"draft/{created.Id}");
        }
        catch (Exception exception)
        {
            notFound = true;
            structureError = exception.Message;
        }
    }

    private static AlgorithmDraft? CreateDisplayDraft(AlgorithmDescriptor descriptor, IAlgorithm algorithm)
    {
        object? definition = algorithm switch
        {
            TuringMachine turing => TuringDraftAdapter.From(turing),
            MarkovAlgorithm markov => MarkovDraftAdapter.From(markov),
            _ => null,
        };

        if (definition is null)
            return null;

        return new AlgorithmDraft
        {
            FamilyId = descriptor.FamilyId,
            Name = algorithm.Name ?? descriptor.Name,
            SourceDescriptorId = descriptor.Id,
            Definition = definition,
        };
    }

    private void RebuildDraft()
    {
        structureError = null;
        if (draft is null)
            return;

        try
        {
            algorithm = DraftAlgorithmFactory.Build(draft);
        }
        catch (Exception exception)
        {
            algorithm = null;
            structureError = exception.Message;
        }

        session.Reset();
    }

    private void OnStructureChanged()
    {
        if (draft is null)
            return;

        var name = draft.Turing?.Name ?? draft.Markov?.Name;
        if (!string.IsNullOrWhiteSpace(name))
            draft.Name = name!;

        DraftStore.NotifyChanged();
        RebuildDraft();
    }

    private void EditAsDraft()
    {
        if (descriptor is null)
            return;

        try
        {
            var forked = DraftAlgorithmFactory.Fork(descriptor);
            DraftStore.Add(forked);
            Navigation.NavigateTo($"draft/{forked.Id}");
        }
        catch (Exception exception)
        {
            structureError = exception.Message;
        }
    }

    private async Task RunAlgorithm()
    {
        StopExecution();
        autoStepping = false;
        EnsureSession(restartIfFinished: true);
        if (!session.IsActive)
            return;

        var cts = new CancellationTokenSource();
        executionCts = cts;
        var token = cts.Token;

        try
        {
            var lastYield = Environment.TickCount64;
            while (!token.IsCancellationRequested && session.Status == TerminationStatus.Unknown)
            {
                session.Step();

                if (Environment.TickCount64 - lastYield < RunYieldIntervalMs)
                    continue;

                lastYield = Environment.TickCount64;
                RenderIfAlive();
                await Task.Yield();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            cts.Dispose();
            if (ReferenceEquals(executionCts, cts))
                executionCts = null;
            RenderIfAlive();
        }
    }

    private void StepAlgorithm()
    {
        StopExecution();
        EnsureSession(restartIfFinished: false);
        session.Step();
    }

    private async Task AutoStepAlgorithm()
    {
        if (autoStepping)
        {
            StopExecution();
            return;
        }

        StopExecution();
        EnsureSession(restartIfFinished: true);
        if (!session.IsActive)
            return;

        autoStepping = true;
        var cts = new CancellationTokenSource();
        executionCts = cts;
        var token = cts.Token;

        try
        {
            while (!token.IsCancellationRequested && session.Status == TerminationStatus.Unknown)
            {
                await Task.Delay(AutoStepDelayMs, token);
                session.Step();
                RenderIfAlive();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            cts.Dispose();
            if (ReferenceEquals(executionCts, cts))
            {
                executionCts = null;
                autoStepping = false;
            }
            RenderIfAlive();
        }
    }

    private void StopExecution() => executionCts?.Cancel();

    private void RenderIfAlive()
    {
        if (!disposed)
            StateHasChanged();
    }

    private void EnsureSession(bool restartIfFinished)
    {
        if (algorithm is null)
            return;

        var steps = (uint)Math.Max(1, maxStepsInput ?? int.MaxValue);
        if (!session.IsStarted || session.Input != input || session.MaxSteps != steps || (restartIfFinished && session.IsFinished))
            session.Start(algorithm, input, steps);
    }

    private void ClearOutput()
    {
        StopExecution();
        autoStepping = false;
        session.Reset(keepInput: true);
    }

    private void ClearInput()
    {
        StopExecution();
        autoStepping = false;
        session.Reset(keepInput: false);
    }

    private void StopAlgorithm() => session.Stop();

    public void Dispose()
    {
        disposed = true;
        executionCts?.Cancel();
        executionCts?.Dispose();
        executionCts = null;
        session.Dispose();
    }
}
