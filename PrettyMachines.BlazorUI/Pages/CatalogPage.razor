@page "/"

@inject NavigationManager Navigation
@inject IStringLocalizer<Locale.Controls> LocControls
@inject AlgorithmLocalizer LocNames


<div class="page-container catalog-page">
    @if (families.Count == 0)
    {
        <i>@LocControls["NoContent"]</i>
    }

    @foreach (var family in families)
    {
        <div class="panel">
            <h4 class="panel-header">@LocNames.GetAlgorithmFamilyName(family.Id)</h4>
            <div class="panel-content">
                <ul class="catalog-list">
                    @foreach (var algorithm in family.Algorithms)
                    {
                        <li>
                            <button class="link-button" @onclick="() => OpenAlgorithm(family.Id, algorithm.Id)">
                                @LocNames.GetAlgorithmName(algorithm.Name)
                            </button>
                        </li>
                    }
                </ul>
                <button class="link-button" @onclick="() => CreateNew(family.Id)">
                    + @LocControls["CreateNew"]
                </button>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<AlgorithmFamily> families = [];

    protected override void OnInitialized() => families = AlgorithmCatalog.Discover();

    private void OpenAlgorithm(string familyId, string algorithmId) => Navigation.NavigateTo($"algorithm/{familyId}/{algorithmId}");

    private void CreateNew(string familyId) => Navigation.NavigateTo($"editor/{familyId}");
}
